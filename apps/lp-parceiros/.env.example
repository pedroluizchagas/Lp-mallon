NEXT_PUBLIC_SITE_URL=https://parceiros.mallevo.com.br
# Painel do lojista: o cadastro é ${NEXT_PUBLIC_APP_URL}/onboarding e o login, /entrar.
NEXT_PUBLIC_APP_URL=https://app.mallevo.com.br
NEXT_PUBLIC_CONSUMIDOR_URL=https://mallevo.com.br
NEXT_PUBLIC_ENTREGADORES_URL=https://entregadores.mallevo.com.br

# Planos e preços ao vivo: a mesma leitura pública da tabela `plans` que o
# passo 12 do cadastro faz (chave anônima). Sem as duas, a seção de preços
# mostra só o que vale para todos os planos — nenhum número copiado à mão.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcionais — sem valor, o elemento correspondente não aparece (nada de link para "#").
# App do lojista (Mallevo Parceiro): sem URL, os botões mostram "Em breve".
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_CONTATO_EMAIL=contato@mallevo.com.br
NEXT_PUBLIC_INSTAGRAM_URL=
# Páginas legais: sem valor, apontam para mallevo.com.br/termos e /privacidade.
NEXT_PUBLIC_TERMOS_URL=
NEXT_PUBLIC_PRIVACIDADE_URL=
