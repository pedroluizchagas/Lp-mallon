NEXT_PUBLIC_SITE_URL=https://mallevo.com.br
NEXT_PUBLIC_APP_URL=https://app.mallevo.com.br
NEXT_PUBLIC_PARCEIROS_URL=https://parceiros.mallevo.com.br
NEXT_PUBLIC_ENTREGADORES_URL=https://entregadores.mallevo.com.br

# Opcionais — sem valor, o elemento correspondente não aparece (nada de link para "#").
# Lojas de apps: sem URL, os botões mostram "Em breve".
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_CONTATO_EMAIL=contato@mallevo.com.br
NEXT_PUBLIC_INSTAGRAM_URL=
# Páginas legais: sem valor, apontam para /termos e /privacidade deste site —
# as mesmas URLs que os apps abrem. Só preencha para mandar a outro endereço.
NEXT_PUBLIC_TERMOS_URL=
NEXT_PUBLIC_PRIVACIDADE_URL=
