NEXT_PUBLIC_SITE_URL=https://entregadores.mallevo.com.br
NEXT_PUBLIC_CONSUMIDOR_URL=https://mallevo.com.br
NEXT_PUBLIC_PARCEIROS_URL=https://parceiros.mallevo.com.br

# O cadastro do entregador existe só dentro do app (Entregadores Mallevo) —
# não há cadastro pela web. Sem as URLs das lojas, os botões mostram
# "Em breve" e o convite da página é um e-mail para a equipe.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Opcionais — sem valor, o elemento correspondente não aparece (nada de link para "#").
NEXT_PUBLIC_CONTATO_EMAIL=contato@mallevo.com.br
NEXT_PUBLIC_INSTAGRAM_URL=
# Páginas legais: sem valor, apontam para mallevo.com.br/termos e /privacidade.
NEXT_PUBLIC_TERMOS_URL=
NEXT_PUBLIC_PRIVACIDADE_URL=
